# Modern PAM settings. Replace every XXXXXX.
SRA_AUTH_MODE="broker"
SRA_GATEWAY_URL="http://akeyless-gateway:8000/api/v2"
SRA_GATEWAY_CONFIG_URL="http://akeyless-gateway:8000"

# The identity the bastion uses to fetch secrets and sign certificates. An API key identity, its own,
# not the gateway's. Keep this file out of source control.
SRA_BROKER_ACCESS_ID="p-XXXXXXXXXXXX"
SRA_BROKER_ACCESS_KEY="XXXXXX"
# Today the broker runs inside the bastion process. Accepting that is a deliberate act, and this build is not for production.
SRA_ALLOW_IN_PROCESS_BROKER="true"

SRA_CONTROL_ADDR="0.0.0.0:9900"
SRA_SSH_ADDR="0.0.0.0:2222"
SRA_SSH_EXTERNAL_PORT="2222"                # The port clients dial, as published in docker-compose.yaml
SRA_SSH_CA_PUBLIC_KEY="XXXXXX"              # The gateway's SSH certificate issuer public key, one line
SRA_SSH_HOST_KEY_FILE="/etc/sra/hostkey"
SRA_SSH_KNOWN_HOSTS_FILE="/etc/sra/known_hosts"
SRA_WEB_ADDR="0.0.0.0:8888"
SRA_GUACD_ADDR="guacd:4822"
