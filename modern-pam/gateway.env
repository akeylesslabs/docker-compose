# Akeyless Gateway settings for the Modern PAM stack. Replace every XXXXXX.
CLUSTER_NAME="XXXXXX"                       # Your gateway name, as it should appear in the console
UNIFIED_GATEWAY="true"
GATEWAY_ACCESS_ID="p-XXXXXXXXXXXX"          # The access id the gateway signs in with
GATEWAY_ACCESS_TYPE="access_key"
GATEWAY_ACCESS_KEY="XXXXXX"                 # Keep this file out of source control
ALLOWED_ACCESS_PERMISSIONS='[{"name":"Administrators","access_id":"p-XXXXXXXXXXXX","permissions":["admin"]}]'
USE_CLUSTER_CACHE="false"

# Where the gateway sends session setup. These two lines are what make this gateway serve Modern PAM,
# so keep the service name modern-pam in step with docker-compose.yaml.
REMOTE_ACCESS_SSH_SERVICE_INTERNAL_URL="http://modern-pam:9900"
REMOTE_ACCESS_WEB_SERVICE_INTERNAL_URL="http://modern-pam:8888"
